import { Palette } from "std-widgets.slint";

// Token di colore Windows 11 (Fluent) che si adattano al tema chiaro/scuro di sistema.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    out property <color> page-bg: dark ? #202020 : #f3f3f3;
    out property <color> nav-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #fbfbfb;
    out property <color> card-bg-alt: dark ? #323232 : #f6f6f6;
    out property <color> card-stroke: dark ? #1c1c1c : #e5e5e5;

    out property <color> text-primary: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #ffffffc9 : #00000099;
    out property <color> text-tertiary: dark ? #ffffff8a : #00000073;

    out property <color> subtle-hover: dark ? #ffffff0f : #0000000a;
    out property <color> subtle-pressed: dark ? #ffffff0a : #00000006;
    out property <color> subtle-selected: dark ? #ffffff14 : #0000000f;

    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> caution: dark ? #fce100 : #9d5d00;
    out property <color> critical: dark ? #ff99a4 : #c42b1c;
    out property <color> critical-bg: dark ? #442726 : #fde7e9;
    out property <color> info-bg: dark ? #2b2b2b : #f6f6f6;

    out property <string> icon-font: "Segoe Fluent Icons";
}

// Glifi del font "Segoe Fluent Icons" incluso in Windows 11.
export global Icons {
    out property <string> download: "\u{E896}";
    out property <string> settings: "\u{E713}";
    out property <string> log: "\u{E9D9}";
    out property <string> folder: "\u{E8B7}";
    out property <string> open-file: "\u{E8E5}";
    out property <string> cancel: "\u{E711}";
    out property <string> pause: "\u{E769}";
    out property <string> play: "\u{E768}";
    out property <string> retry: "\u{E72C}";
    out property <string> delete: "\u{E74D}";
    out property <string> video: "\u{E714}";
    out property <string> music: "\u{E8D6}";
    out property <string> playlist: "\u{E90B}";
    out property <string> error: "\u{E783}";
    out property <string> ok: "\u{E73E}";
    out property <string> info: "\u{E946}";
    out property <string> paste: "\u{E77F}";
    out property <string> search: "\u{E721}";
    out property <string> clear: "\u{E894}";
    out property <string> link: "\u{E71B}";
}
